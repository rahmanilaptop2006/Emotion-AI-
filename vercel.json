{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/__/auth/(.*)",
      "destination": "https://gen-lang-client-0210144766.firebaseapp.com/__/auth/$1"
    },
    {
      "source": "/((?!api/|auth/|assets/|sounds/|hero\\.mp4|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
